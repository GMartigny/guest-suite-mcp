{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "rewrites": [
        {
            "source": "/mcp",
            "destination": "/api/mcp"
        },
        {
            "source": "/mcp/:token",
            "destination": "/api/mcp?token=:token"
        }
    ]
}
